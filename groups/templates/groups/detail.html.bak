{% extends "base.html" %}

{% block title %}{{ faction.Name }} — Группировки{% endblock %}

{% block body_class %}page page-groups page-group-detail{% endblock %}

{% block content %}
    <a class="back-link" href="{{ url_for('groups.index') }}">← Все группировки</a>

    <section class="group-header" style="border-left: 6px solid {{ color }};">
        <h1 style="color: {{ color }};">{{ faction.Name }}</h1>

        <dl class="group-info">
            <dt>Цвет</dt>
            <dd>
                <span class="color-dot" style="background: {{ color }};"></span>
                {{ color }}
            </dd>

            <dt>Участников</dt>
            <dd>{{ members_data|length }} / {{ faction.MaxMembers }}</dd>

            <dt>Способности</dt>
            <dd>{{ faction.Abilities }}</dd>
        </dl>
    </section>

    <section class="group-members-list">
        <h2>Состав группировки</h2>

        {% if members_data %}
            <table class="members-table">
                <thead>
                    <tr>
                        <th>Игрок</th>
                        <th>Игровой ранг</th>
                        <th>Роль в группировке</th>
                    </tr>
                </thead>
                <tbody>
                    {% for member in members_data %}
                        <tr>
                            <td>
                                <a href="{{ url_for('profile.view_profile', steam_id=member.player.SteamID) }}" class="player-cell">
                                    <span class="player-avatar-letter">{{ (member.player.Nickname or "Б")[:1] }}</span>
                                    <span class="player-cell-name">{{ member.player.Nickname or "Без ника" }}</span>
                                </a>
                            </td>
                            <td>{{ member.rank.Name }}</td>
                            <td>{{ member.role_label }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p>В этой группировке пока нет участников.</p>
        {% endif %}
    </section>
{% endblock %}