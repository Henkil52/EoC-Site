/* ══════════════════════════════════════════════════════════
   ui.css — дизайн-слой: шрифты, кнопки, карточки, формы.
   Подключается ПОСЛЕ base.css и themes.css.
   ══════════════════════════════════════════════════════════ */

/* ── Шрифты (кириллица поддерживается) ───────────────────── */
@import url('https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&family=Exo+2:wght@600;700;800&display=swap');

/* ── Дизайн-токены ───────────────────────────────────────── */
:root {
    --radius: 16px;
    --radius-sm: 10px;
    --transition: .18s ease;
}

html[data-theme="dark"]  { --accent: #4fc3f7; --accent-2: #0288d1; --glow: rgba(79,195,247,.25); }
html[data-theme="gray"]  { --accent: #8ab4f8; --accent-2: #5c7cfa; --glow: rgba(138,180,248,.25); }
html[data-theme="light"] { --accent: #0077e6; --accent-2: #0091ea; --glow: rgba(0,119,230,.18); }

/* ── База: шрифты и фон ──────────────────────────────────── */
body {
    font-family: 'Rubik', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    line-height: 1.6;
}

h1, h2, h3, h4, .auth-gate h1 {
    font-family: 'Exo 2', 'Rubik', sans-serif;
    letter-spacing: .3px;
}

h1 { font-weight: 800; }
h2 { font-weight: 700; }

::selection { background: var(--accent); color: #fff; }

/* Тонкий скроллбар */
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 6px; }
::-webkit-scrollbar-thumb:hover { background: var(--accent); }

/* ── Навбар: липкий, с блюром ────────────────────────────── */
nav, .navbar, header {
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(12px);
    box-shadow: 0 2px 12px var(--shadow);
    border-bottom: 1px solid var(--border);
}

.nav-list a {
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    transition: background var(--transition), color var(--transition);
    font-weight: 500;
}

.nav-list a:hover { background: var(--hover); }

.nav-list a[aria-current="page"] {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #fff;
}

/* ── Карточки-блоки ──────────────────────────────────────── */
.player-card,
.game-info,
.player-stats,
.extended-stats,
.weapon-stats,
.player-appeals,
.player-logs,
.news-item,
.news-full,
.rules-section,
.lore-entry,
.leaderboard-category,
.admin-rules-section,
.admin-lore-section,
.log-sources,
.log-source-add,
.appeal-full,
.env-warning,
.auth-gate {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px 24px;
    box-shadow: 0 8px 24px var(--shadow);
    margin-bottom: 20px;
    transition: box-shadow var(--transition), transform var(--transition);
}

.player-card:hover,
.news-item:hover,
.leaderboard-category:hover {
    box-shadow: 0 12px 32px var(--shadow);
    transform: translateY(-2px);
}

/* Заголовки секций с акцентной полосой */
.player-stats h3,
.game-info h3,
.weapon-stats h3,
.extended-stats h3,
.player-appeals h3,
.player-logs h3 {
    padding-left: 12px;
    border-left: 4px solid var(--accent);
    margin-bottom: 16px;
}

/* ── Кнопки ──────────────────────────────────────────────── */
.btn,
.auth-gate-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #fff;
    font-family: 'Rubik', sans-serif;
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 4px 14px var(--glow);
    transition: transform var(--transition), box-shadow var(--transition), filter var(--transition);
}

.btn:hover,
.auth-gate-button:hover {
    transform: translateY(-2px);
    filter: brightness(1.1);
    box-shadow: 0 8px 20px var(--glow);
}

.btn:active,
.auth-gate-button:active { transform: translateY(0); filter: brightness(.95); }

.btn-sm { padding: 6px 12px; font-size: 13px; border-radius: 8px; }

.btn-danger {
    background: linear-gradient(135deg, #e53935, #b71c1c);
    box-shadow: 0 4px 14px rgba(229,57,53,.3);
}

/* Кнопка-ссылка (нейтральная) */
a.btn { color: #fff; }

/* ── Формы ───────────────────────────────────────────────── */
input[type="text"],
input[type="password"],
input[type="number"],
textarea,
select {
    font-family: 'Rubik', sans-serif;
    font-size: 14px;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--input-bg);
    color: var(--text);
    transition: border-color var(--transition), box-shadow var(--transition);
}

input:focus,
textarea:focus,
select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--glow);
}

/* ── Таблицы ─────────────────────────────────────────────── */
table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--border);
}

table th {
    font-family: 'Exo 2', sans-serif;
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: .5px;
}

table tbody tr { transition: background var(--transition); }
table tbody tr:hover { background: var(--hover); }

/* ── Бейджи ролей ────────────────────────────────────────── */
.role-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--card-alt);
    border: 1px solid var(--border);
    font-size: 13px;
    font-weight: 600;
}

/* ── Раскрывающиеся блоки (details) ──────────────────────── */
details {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
}

details summary {
    padding: 12px 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background var(--transition);
}

details summary:hover { background: var(--hover); }

/* ── Ссылки ──────────────────────────────────────────────── */
a { transition: color var(--transition); }

/* ── Flash-сообщения ─────────────────────────────────────── */
.flash {
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 14px var(--shadow);
    font-weight: 500;
}
/* ══════════════════════════════════════════════════════════
   КРАСИВОЕ РАСПОЛОЖЕНИЕ ИНФОРМАЦИИ (профиль)
   ══════════════════════════════════════════════════════════ */

/* ── Шапка профиля: аватар слева, имя и бейджи справа ────── */
.player-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 20px;
    align-items: center;
}

.player-avatar {
    grid-column: 1;
    grid-row: 1 / 3;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    border: 3px solid var(--accent);
    box-shadow: 0 0 0 4px var(--glow);
    object-fit: cover;
}

.player-card h2 {
    grid-column: 2;
    margin: 0;
    font-size: 26px;
}

.player-card .role-badges {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.player-card .player-info {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 16px;
    margin: 12px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--border);
}

/* ── Двухколоночная сетка блоков профиля ─────────────────── */
.game-profile {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    align-items: start;
}

.game-info { grid-column: 1; margin-bottom: 0; }
.player-stats { grid-column: 2; margin-bottom: 0; }
.player-appeals,
.player-logs { grid-column: 1 / -1; }

/* ── Статистика плитками ─────────────────────────────────── */
.player-stats dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.player-stats dt {
    background: var(--card-alt);
    border: 1px solid var(--border);
    border-right: none;
    border-radius: 10px 0 0 10px;
    padding: 10px 12px;
    color: var(--muted);
    font-size: 13px;
    display: flex;
    align-items: center;
}

.player-stats dd {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 0 10px 10px 0;
    padding: 10px 12px;
    margin: 0;
    font-weight: 700;
    display: flex;
    align-items: center;
}

/* ── Игровая информация: аккуратные строки ───────────────── */
.game-info dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 16px;
    margin: 0;
}

.game-info dt { color: var(--muted); font-size: 14px; }
.game-info dd { margin: 0; font-weight: 600; }

/* ── Адаптивность: на узких экранах — одна колонка ───────── */
@media (max-width: 900px) {
    .game-profile { grid-template-columns: 1fr; }
    .game-info,
    .player-stats,
    .player-appeals,
    .player-logs { grid-column: 1; }

    .player-card { grid-template-columns: 1fr; text-align: center; }
    .player-avatar { grid-column: 1; grid-row: auto; margin: 0 auto; }
    .player-card h2,
    .player-card .role-badges { grid-column: 1; justify-content: center; }
    .player-card .role-badges { display: flex; }
}
/* ══════════════════════════════════════════════════════════
   КРАСИВОЕ РАСПОЛОЖЕНИЕ — ВСЕ СТРАНИЦЫ
   ══════════════════════════════════════════════════════════ */

/* ── Заголовки страниц с акцентной полосой ───────────────── */
h1 {
    position: relative;
    padding-bottom: 12px;
    margin-bottom: 24px;
}

h1::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 64px;
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
}

/* ── Ритм секций ─────────────────────────────────────────── */
section,
.rules-section,
.lore-section,
.leaderboard-category,
.admin-rules-section,
.admin-lore-section {
    margin-bottom: 24px;
}

/* ── НОВОСТИ ─────────────────────────────────────────────── */
.news-item {
    display: block;
    text-decoration: none;
    color: var(--text);
}

.news-item h2,
.news-item h3 {
    margin: 0 0 8px 0;
    transition: color var(--transition);
}

.news-item:hover h2,
.news-item:hover h3 { color: var(--accent); }

.news-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 13px;
    margin-bottom: 8px;
}

.news-content {
    line-height: 1.7;
}

/* ── ПРАВИЛА и ЛОР: аккуратные нумерованные списки ────────── */
.rules-section ol,
.lore-section ol {
    padding-left: 8px;
    list-style: none;
    counter-reset: rule;
}

.rules-section ol li,
.lore-section ol li {
    counter-increment: rule;
    position: relative;
    padding: 10px 12px 10px 48px;
    margin-bottom: 8px;
    background: var(--card-alt);
    border: 1px solid var(--border);
    border-radius: 10px;
}

.rules-section ol li::before,
.lore-section ol li::before {
    content: counter(rule);
    position: absolute;
    left: 12px;
    top: 10px;
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #fff;
    font-family: 'Exo 2', sans-serif;
    font-weight: 700;
    font-size: 13px;
    border-radius: 8px;
}

/* ── ОБРАЩЕНИЯ: диалог как чат-пузыри ────────────────────── */
.messages-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.message {
    max-width: 85%;
    background: var(--card-alt);
    border: 1px solid var(--border);
    border-left: 4px solid var(--muted);
    border-radius: 14px;
    padding: 12px 16px;
}

.message-admin {
    align-self: flex-end;
    border-left: 1px solid var(--border);
    border-right: 4px solid var(--accent);
    background: var(--card);
}

.message-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
    font-size: 13px;
    color: var(--muted);
}

.message-body { line-height: 1.6; }

/* ── АДМИНКА: меню плитками ──────────────────────────────── */
.admin-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
}

.admin-menu li a {
    display: block;
    padding: 18px 16px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-align: center;
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
    transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
}

.admin-menu li a:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: 0 8px 20px var(--glow);
}

/* ── Формы создания (обращения, новости, лор) ────────────── */
.appeal-form,
.news-form,
.entry-create-form,
.entry-edit-form {
    max-width: 760px;
}

.appeal-form label,
.news-form label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 14px;
    font-weight: 500;
}

/* ── ЛИДЕРЫ: карточки-подиум ─────────────────────────────── */
.leaderboard-table tbody tr:first-child td {
    background: var(--card-alt);
}

.leaderboard-table td.rank-cell { font-size: 20px; }

/* ── ПУСТЫЕ СОСТОЯНИЯ ────────────────────────────────────── */
.game-profile-empty,
.leaderboard-category p,
.log-sources p {
    padding: 16px;
    background: var(--card-alt);
    border: 1px dashed var(--border);
    border-radius: 10px;
    color: var(--muted);
}

/* ── Адаптивность ────────────────────────────────────────── */
@media (max-width: 700px) {
    .message { max-width: 100%; }
    .admin-menu ul { grid-template-columns: 1fr 1fr; }
    .rules-section ol li,
    .lore-section ol li { padding-left: 44px; }
}
/* ── BB-редактор ─────────────────────────────────────────── */

.editor-toolbar {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    align-items: center;
    padding: 6px;
    background: var(--card-alt);
    border: 1px solid var(--border);
    border-bottom: none;
    border-radius: 10px 10px 0 0;
    position: relative;
}

.editor-toolbar button {
    min-width: 32px;
    height: 32px;
    padding: 0 8px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--text);
    border-radius: 6px;
    cursor: pointer;
    font-size: 13px;
    transition: all var(--transition);
}

.editor-toolbar button:hover {
    background: var(--hover);
    border-color: var(--accent);
}

textarea.rich-editor.editor-area {
    border-radius: 0 0 10px 10px;
}

.emoji-picker {
    display: none;
    position: absolute;
    top: 100%;
    right: 0;
    z-index: 50;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 8px;
    grid-template-columns: repeat(10, 32px);
    gap: 4px;
    box-shadow: 0 8px 24px var(--shadow);
}

.emoji-picker.open { display: grid; }

.emoji-picker button {
    border: none;
    background: transparent;
    font-size: 18px;
    cursor: pointer;
    border-radius: 6px;
    min-width: 0;
    height: 32px;
}

.emoji-picker button:hover { background: var(--hover); }

/* ── Отображение BB-кодов ────────────────────────────────── */

.bb-quote {
    border-left: 4px solid var(--accent);
    background: var(--card-alt);
    padding: 8px 12px;
    margin: 8px 0;
    border-radius: 0 8px 8px 0;
    color: var(--muted);
}

.bb-code {
    background: #1e1e1e;
    color: #d4d4d4;
    padding: 8px 12px;
    border-radius: 8px;
    font-family: 'Courier New', monospace;
    white-space: pre-wrap;
    margin: 8px 0;
}

.bb-list {
    margin: 8px 0;
    padding-left: 24px;
    list-style: disc;
}
/* ── Чекбоксы: в один уровень с надписью ─────────────────── */

input[type="checkbox"] {
    width: 18px;
    height: 18px;
    margin: 0;
    flex-shrink: 0;
    accent-color: var(--accent);
    cursor: pointer;
}

/* Лейбл с чекбоксом — строкой, а не столбцом */
form label:has(input[type="checkbox"]),
.news-form label:has(input[type="checkbox"]),
.appeal-form label:has(input[type="checkbox"]) {
    flex-direction: row;
    align-items: center;
    gap: 10px;
}
/* ══════════════════════════════════════════════════════════
   НАВБАР: одна строка + кнопки во всех пунктах
   ══════════════════════════════════════════════════════════ */

/* Контейнер навбара — в одну строку */
nav, .navbar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 10px 16px;
}

/* Главное меню — горизонтально, без маркеров-точек */
.nav-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
}

.nav-list li { list-style: none; }

/* ВСЕ пункты меню — кнопки-пилюли (не только активный) */
.nav-list a {
    display: inline-block;
    padding: 8px 14px;
    border-radius: 10px;
    text-decoration: none;
    color: var(--text);
    font-weight: 500;
}

.nav-list a:hover {
    background: var(--hover);
    color: var(--accent);
}

/* Скрыть пустые li (лишние точки) */
nav li:empty { display: none; }

/* Кнопку темы — прижать вправо */
.nav-theme { margin-left: auto; }

/* ── Дропдаун профиля ────────────────────────────────────── */
nav details { position: relative; }

nav details summary {
    list-style: none;
    cursor: pointer;
    padding: 8px 14px;
    border-radius: 10px;
    background: var(--card-alt);
    border: 1px solid var(--border);
    font-weight: 600;
    transition: background var(--transition);
}

nav details summary:hover { background: var(--hover); }

nav details summary::-webkit-details-marker { display: none; }

/* Выпадающее меню — вертикальное, поверх контента, без точек */
nav details ul {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    min-width: 240px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 8px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 12px 32px var(--shadow);
    z-index: 300;
}

nav details ul li a {
    display: block;
    padding: 8px 12px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--text);
}

nav details ul li a:hover {
    background: var(--hover);
    color: var(--accent);
}

/* Бейджи ролей внутри дропдауна */
nav details ul .role-badge { margin: 4px 8px; }
/* ══════════════════════════════════════════════════════════
   ЛОГОТИП СЛЕВА + МЕНЮ ПО ЦЕНТРУ
   ══════════════════════════════════════════════════════════ */

.nav-logo {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    text-decoration: none;
    white-space: nowrap;
}

.nav-logo-icon {
    font-size: 20px;
}

.nav-logo-main {
    font-family: 'Exo 2', sans-serif;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transition: filter var(--transition);
}

.nav-logo:hover .nav-logo-main {
    filter: brightness(1.25);
}

.nav-logo-sub {
    font-family: 'Exo 2', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted);
}

/* Меню центрируется между логотипом и правым блоком */
.nav-list {
    margin-left: auto;
    margin-right: auto;
}

/* Кнопка темы больше не прижимается к правому краю внутри меню */
.nav-list .nav-theme {
    margin-left: 12px;
}
/* ── Фикс: выпадающий профиль не обрезается ──────────────── */

nav, .navbar, header {
    overflow: visible;
}

nav details {
    position: relative;
    z-index: 400;
}

nav details[open] summary {
    border-color: var(--accent);
}

nav details[open] ul {
    display: flex;
}
/* ══════════════════════════════════════════════════════════
   ФИКС ДРОПДАУНА ПРОФИЛЯ (точные селекторы .main-nav / .profile-dropdown)
   ══════════════════════════════════════════════════════════ */

/* Разрешаем меню выходить за пределы навбара */
header.site-header,
nav.main-nav {
    overflow: visible;
}

/* Контейнер дропдауна — поверх контента */
details.profile-dropdown {
    position: relative;
    z-index: 500;
}

/* Само меню: скрыто по умолчанию, абсолютно поверх страницы */
details.profile-dropdown .profile-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    min-width: 260px;
    display: none;
    flex-direction: column;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 8px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 12px 32px var(--shadow);
    z-index: 600;
}

/* Открытое меню — показываем */
details.profile-dropdown[open] .profile-menu {
    display: flex;
}

/* Пункты меню */
details.profile-dropdown .profile-menu li a {
    display: block;
    padding: 8px 12px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--text);
}

details.profile-dropdown .profile-menu li a:hover {
    background: var(--hover);
    color: var(--accent);
}

details.profile-dropdown .profile-menu .logout-link {
    color: #e57373;
}

/* Разделители */
details.profile-dropdown .profile-menu .menu-divider {
    height: 1px;
    background: var(--border);
    margin: 6px 8px;
    padding: 0;
}

/* Бейджи ролей внутри меню */
details.profile-dropdown .profile-menu .role-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 4px 8px;
}

/* Кнопка темы (li вне ul) — без точки-маркера */
li.nav-theme {
    list-style: none;
    display: flex;
    align-items: center;
}
/* ══════════════════════════════════════════════════════════
   КОММЕНТАРИИ: большое окно ввода + кнопки администрации
   ══════════════════════════════════════════════════════════ */

/* ── Редактор: панель и поле одной шириной ───────────────── */
.editor-toolbar {
    width: 100%;
    box-sizing: border-box;
}

textarea.rich-editor {
    width: 100%;
    min-height: 140px;
    resize: vertical;
    box-sizing: border-box;
}

/* ── Список комментариев: без точек, карточками ──────────── */
.comments-list,
.news-comments ul,
ul.comments {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.comments-list li,
.news-comments ul li,
ul.comments li {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px 16px;
    box-shadow: 0 4px 14px var(--shadow);
}

/* ── Кнопки администрации в комментариях ─────────────────── */
.comments-list li form,
.news-comments ul li form,
ul.comments li form,
.comment form {
    display: inline-flex;
    margin: 0;
}

.comments-list li a[href*="edit"],
.comments-list li button,
.news-comments ul li a[href*="edit"],
.news-comments ul li button,
ul.comments li a[href*="edit"],
ul.comments li button,
.comment a[href*="edit"],
.comment button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    margin: 4px 6px 0 0;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--card-alt);
    color: var(--text);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: all var(--transition);
}

/* Редактировать — акцент при наведении */
.comments-list li a[href*="edit"]:hover,
.news-comments ul li a[href*="edit"]:hover,
ul.comments li a[href*="edit"]:hover,
.comment a[href*="edit"]:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
}

/* Удалить / Скрыть — красный при наведении */
.comments-list li form[action*="delete"] button:hover,
.comments-list li form[action*="hide"] button:hover,
.news-comments ul li form[action*="delete"] button:hover,
.news-comments ul li form[action*="hide"] button:hover,
ul.comments li form[action*="delete"] button:hover,
ul.comments li form[action*="hide"] button:hover,
.comment form[action*="delete"] button:hover,
.comment form[action*="hide"] button:hover {
    border-color: #e57373;
    color: #e57373;
    transform: translateY(-1px);
}

/* ── Форма комментария: отступ сверху ────────────────────── */
.news-comments form,
.comment-form {
    margin-top: 16px;
}
/* ══════════════════════════════════════════════════════════
   АДМИН-ПАНЕЛЬ: карточки статистики и меню
   ══════════════════════════════════════════════════════════ */

.admin-dashboard {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin: 24px 0 32px;
}

.stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 24px 16px 20px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 6px 18px var(--shadow);
    text-align: center;
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
}

.stat-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: 0 10px 26px var(--glow);
}

/* Иконки карточек */
.stat-card::before {
    font-size: 28px;
    line-height: 1;
}
.stat-card:nth-child(1)::before { content: "👥"; }
.stat-card:nth-child(2)::before { content: "🛡️"; }
.stat-card:nth-child(3)::before { content: "⚠️"; }

/* Крупная цифра — над подписью (без правки HTML) */
.stat-card .stat-number {
    order: 1;
    margin: 0;
    font-family: 'Exo 2', sans-serif;
    font-size: 36px;
    font-weight: 800;
    color: var(--accent);
    line-height: 1;
}

.stat-card h3 {
    order: 2;
    margin: 0;
    font-family: 'Rubik', sans-serif;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .8px;
    color: var(--muted);
}

/* Иконки плиток меню (у кого их нет) */
.admin-menu li:nth-child(1) a::before { content: "🎭 "; }
.admin-menu li:nth-child(2) a::before { content: "👥 "; }
.admin-menu li:nth-child(3) a::before { content: "⚠️ "; }
.admin-menu li:nth-child(5) a::before { content: "📨 "; }

/* ══ ДРОПДАУН ПРОФИЛЯ (JS-версия) ══════════════════════════ */

.profile-dropdown {
    position: relative;
    z-index: 500;
}

button.profile-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: var(--card-alt);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: background var(--transition);
}

button.profile-button:hover { background: var(--hover); }

.profile-button img {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
}

.profile-button .avatar-placeholder {
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: #fff;
    border-radius: 50%;
    font-size: 13px;
}

.profile-dropdown .profile-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    min-width: 260px;
    display: none;
    flex-direction: column;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 8px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 12px 32px var(--shadow);
    z-index: 600;
}

.profile-dropdown.open .profile-menu {
    display: flex !important;
}

.profile-menu li a {
    display: block;
    padding: 8px 12px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--text);
}

.profile-menu li a:hover {
    background: var(--hover);
    color: var(--accent);
}

.profile-menu .logout-link { color: #e57373; }

.profile-menu .menu-divider {
    height: 1px;
    background: var(--border);
    margin: 6px 8px;
    padding: 0;
}

.profile-menu .role-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 4px 8px;
}


/* ══ КНОПКИ "НАЗАД" (← ...) ════════════════════════════════ */

a.back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    margin: 0 0 16px 0;
    background: var(--card-alt);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text);
    font-weight: 500;
    font-size: 14px;
    text-decoration: none;
    transition: all var(--transition);
}

a.back-link:hover {
    background: var(--hover);
    border-color: var(--accent);
    color: var(--accent);
    transform: translateX(-3px);
}
/* ══════════════════════════════════════════════════════════
   ГРУППИРОВКИ: карточки и страница группировки
   ══════════════════════════════════════════════════════════ */

/* ── Список: сетка карточек ──────────────────────────────── */
.groups-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
    margin-top: 20px;
}

.group-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 6px 18px var(--shadow);
    text-decoration: none;
    color: var(--text);
    transition: transform var(--transition), box-shadow var(--transition);
}

.group-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px var(--shadow);
}

.group-card h2 {
    margin: 0;
    font-family: 'Exo 2', sans-serif;
    font-size: 20px;
    font-weight: 700;
}

.group-members {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
}

.group-hint {
    margin: auto 0 0;
    color: var(--accent);
    font-size: 13px;
    font-weight: 600;
}

/* ── Страница группировки: шапка ─────────────────────────── */
.group-header {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px 24px;
    box-shadow: 0 6px 18px var(--shadow);
    margin-bottom: 24px;
}

.group-header h1 {
    margin: 0 0 16px;
}

.group-info {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 16px;
    margin: 0;
}

.group-info dt { color: var(--muted); font-size: 14px; }

.group-info dd {
    margin: 0;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
}

.color-dot {
    display: inline-block;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid var(--border);
}

/* ── Состав группировки ──────────────────────────────────── */
.group-members-list {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px 24px;
    box-shadow: 0 6px 18px var(--shadow);
}

.group-members-list h2 {
    margin-top: 0;
    padding-left: 12px;
    border-left: 4px solid var(--accent);
}

.members-table { width: 100%; }

/* ══════════════════════════════════════════════════════════
   ФОНЫ ТЕМ + ПРОЗРАЧНЫЕ БЛОКИ (70%, оттенок темы, стекло)
   ══════════════════════════════════════════════════════════ */

/* ── Фоны body по темам ──────────────────────────────────── */
html[data-theme="dark"] body {
    background: var(--bg) url("../bg-dark.jpg") center / cover no-repeat fixed;
}

html[data-theme="gray"] body,
html[data-theme="light"] body {
    background: var(--bg) url("../bg-light.jpg") center / cover no-repeat fixed;
}

/* ── Полупрозрачные (70%) цвета с оттенком темы ──────────── */
html[data-theme="dark"] {
    --card: rgba(16, 18, 22, .7);
    --card-alt: rgba(30, 34, 40, .7);
    --nav-bg: rgba(14, 16, 20, .8);
    --input-bg: rgba(24, 28, 33, .7);
    --th-bg: rgba(24, 28, 33, .7);
    --hover: rgba(42, 48, 56, .6);
}

html[data-theme="gray"] {
    --card: rgba(52, 58, 64, .7);
    --card-alt: rgba(66, 73, 80, .7);
    --nav-bg: rgba(40, 45, 50, .8);
    --input-bg: rgba(72, 79, 86, .7);
    --th-bg: rgba(72, 79, 86, .7);
    --hover: rgba(84, 92, 100, .6);
}

html[data-theme="light"] {
    --card: rgba(255, 255, 255, .7);
    --card-alt: rgba(248, 249, 250, .7);
    --nav-bg: rgba(255, 255, 255, .8);
    --input-bg: rgba(255, 255, 255, .7);
    --th-bg: rgba(238, 241, 244, .7);
    --hover: rgba(240, 242, 245, .6);
}

/* ── Эффект стекла: блюр под блоками ─────────────────────── */
.player-card, .game-info, .player-stats, .extended-stats, .weapon-stats,
.player-appeals, .player-logs, .player-log-block, .news-item, .news-full,
.rules-section, .lore-entry, .leaderboard-category, .admin-rules-section,
.admin-lore-section, .log-sources, .auth-gate, .stat-card, .admin-stat-card,
.group-card, .group-header, .group-members-list,
.site-header, .main-nav, .profile-dropdown .profile-menu, .emoji-picker,
.editor-toolbar, .weapons-table, .admin-table, .players-table, .members-table {
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
}



/* ══ СПИСОК ИГРОКОВ (админка + состав группировок) ══════════ */

.players-table td,
.members-table td {
    vertical-align: middle;
}

/* Ячейка игрока: аватар-буква + ник */
.player-cell {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
}

.player-cell:hover .player-cell-name { color: var(--accent); }

.player-avatar-letter {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #fff;
    border-radius: 50%;
    font-family: 'Exo 2', sans-serif;
    font-weight: 700;
    font-size: 15px;
    text-transform: uppercase;
}

.player-cell-name {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
}

/* Steam ID — мелкий и серый */
.players-table td:nth-child(2) {
    color: var(--muted);
    font-size: 12px;
    font-family: 'Courier New', monospace;
}

/* Пилюли статуса */
.status-active,
.status-banned {
    display: inline-flex;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
}

.status-active { background: rgba(40, 167, 69, .15); color: #28a745; }
.status-banned { background: rgba(220, 53, 69, .15); color: #dc3545; }

/* Забаненные — красная подсветка строки */
.players-table tr.player-banned td {
    background: rgba(220, 53, 69, .06);
}

.players-table tr.player-banned .player-cell-name {
    text-decoration: line-through;
    color: var(--muted);
}

/* ══════════════════════════════════════════════════════════
   НОВОСТИ: ВСЕ внутренние блоки — прозрачные, как остальные
   ══════════════════════════════════════════════════════════ */

.news-content pre,
.news-content code,
.news-content blockquote,
.news-content div,
.news-content p,
.news-full pre,
.news-full code,
.news-full blockquote,
.news-full div,
.news-full p {
    background: transparent !important;
    color: var(--text) !important;
}

/* Код-блоки — только рамка, без фона */
.news-content pre,
.news-full pre {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 14px;
    margin: 8px 0;
    white-space: pre-wrap;
    word-break: break-word;
}

/* Добавленное — полупрозрачный зелёный */
.news-content ins,
.news-full ins {
    background: rgba(40, 167, 69, .18) !important;
    color: #6fcf7c !important;
    text-decoration: none;
    padding: 2px 6px;
    border-radius: 4px;
}

/* Удалённое — полупрозрачный красный */
.news-content del,
.news-full del {
    background: rgba(220, 53, 69, .18) !important;
    color: #e57373 !important;
    padding: 2px 6px;
    border-radius: 4px;
}

/* Названия разделов — полупрозрачный янтарный */
.news-content mark,
.news-full mark {
    background: rgba(255, 193, 7, .22) !important;
    color: var(--text) !important;
    padding: 2px 8px;
    border-radius: 4px;
}

/* ══ АВАТАРЫ: загрузка и смена ═════════════════════════════ */

.avatar-controls {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 4px;
}

.avatar-upload-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border: 1px dashed var(--accent);
    border-radius: 8px;
    color: var(--accent);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition);
}

.avatar-upload-btn:hover {
    background: var(--glow);
}

.player-avatar-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #fff;
    font-family: 'Exo 2', sans-serif;
    font-size: 40px;
    font-weight: 800;
    text-transform: uppercase;
}
/* ══════════════════════════════════════════════════════════
   ПРОФИЛЬ: красивая шапка с баннером и аватаркой
   ══════════════════════════════════════════════════════════ */

.player-card {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 6px 20px;
    padding: 0 24px 24px;
    overflow: hidden;
    position: relative;
}

/* ── Баннер сверху карточки (градиент в цвет темы) ───────── */
.player-card::before {
    content: "";
    grid-column: 1 / -1;
    grid-row: 1;
    height: 100px;
    margin: 0 -24px;
    background:
        radial-gradient(circle at 15% 30%, var(--glow), transparent 55%),
        radial-gradient(circle at 85% 20%, var(--glow), transparent 50%),
        linear-gradient(135deg, var(--accent), var(--accent-2));
    opacity: .9;
}

/* ── Аватарка: крупная, с рамкой, наезжает на баннер ──────── */
.player-card .player-avatar {
    grid-column: 1;
    grid-row: 2;
    width: 116px;
    height: 116px;
    margin-top: -58px;
    border-radius: 50%;
    border: 4px solid var(--card);
    box-shadow: 0 0 0 3px var(--accent), 0 10px 26px var(--shadow);
    object-fit: cover;
    background: var(--card-alt);
    z-index: 1;
    transition: transform var(--transition), box-shadow var(--transition);
}

.player-card .player-avatar:hover {
    transform: scale(1.04);
    box-shadow: 0 0 0 3px var(--accent), 0 14px 32px var(--glow);
}

/* ── Никнейм — у нижнего края аватарки ────────────────────── */
.player-card h2 {
    grid-column: 2;
    grid-row: 2;
    align-self: end;
    margin: 0 0 6px;
    font-size: 28px;
}

/* ── Кнопки аватара — под аватаркой ───────────────────────── */
.player-card .avatar-controls {
    grid-column: 1;
    grid-row: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
}

/* ── Бейджи ролей — под никнеймом ─────────────────────────── */
.player-card .role-badges {
    grid-column: 2;
    grid-row: 3;
    align-self: start;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
}

/* ── Steam-информация — снизу, через разделитель ─────────── */
.player-card .player-info {
    grid-column: 1 / -1;
    grid-row: 4;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 16px;
    margin: 18px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--border);
}

/* ── Мобильная версия: всё по центру ──────────────────────── */
@media (max-width: 700px) {
    .player-card {
        grid-template-columns: 1fr;
        justify-items: center;
        text-align: center;
    }

    .player-card .player-avatar { grid-column: 1; grid-row: 2; }
    .player-card h2 { grid-column: 1; grid-row: 3; align-self: start; margin-top: 10px; }
    .player-card .role-badges { grid-column: 1; grid-row: 4; justify-content: center; }
    .player-card .avatar-controls { grid-column: 1; grid-row: 5; }
    .player-card .player-info { grid-column: 1; grid-row: 6; }
}
/* ══════════════════════════════════════════════════════════
   ПРОФИЛЬ: три блока одной ширины
   ══════════════════════════════════════════════════════════ */

.player-stats-block,
.player-admin-block {
    margin-top: 20px;
}

/* Игровая информация — две колонки пар */
.player-card .player-info {
    grid-template-columns: repeat(2, auto 1fr);
}

/* Статистика — две пары плиток в ряд на широких экранах */
.player-stats dl {
    grid-template-columns: repeat(2, 1fr 1fr);
}

/* ── Админ-раздел ────────────────────────────────────────── */
.player-admin-block h3 {
    padding-left: 12px;
    border-left: 4px solid var(--accent);
    margin-bottom: 16px;
}

.player-admin-block h4 {
    margin: 0 0 12px 0;
    font-family: 'Exo 2', sans-serif;
}

.player-admin-block .player-appeals,
.player-admin-block .player-logs {
    margin-bottom: 16px;
    background: var(--card-alt);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
}

.player-admin-block .player-appeals:last-child,
.player-admin-block .player-logs:last-child {
    margin-bottom: 0;
}

/* ── Адаптив ─────────────────────────────────────────────── */
@media (max-width: 900px) {
    .player-stats dl { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 700px) {
    .player-card .player-info { grid-template-columns: auto 1fr; }
}

/* ══ КАСТОМНЫЙ БАННЕР ПРОФИЛЯ ═══════════════════════════════ */

.player-card::before {
    content: "";
    grid-column: 1 / -1;
    grid-row: 1;
    height: 100px;
    margin: 0 -24px;
    background-image:
        var(--banner-url, none),
        radial-gradient(circle at 15% 30%, var(--glow), transparent 55%),
        radial-gradient(circle at 85% 20%, var(--glow), transparent 50%),
        linear-gradient(135deg, var(--accent), var(--accent-2));
    background-size: cover, auto, auto, auto;
    background-position: center, auto, auto, auto;
    opacity: .95;
}

/* С кастомным баннером — выше, аватар глубже наезжает */
.player-card.has-custom-banner::before {
    height: 160px;
}

.player-card.has-custom-banner .player-avatar {
    margin-top: -78px;
}


/* ══ НАСТРОЙКИ ПРОФИЛЯ ═════════════════════════════════════ */

.settings-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px 24px;
    box-shadow: 0 6px 18px var(--shadow);
    margin-bottom: 20px;
    backdrop-filter: blur(10px);
}

.settings-card h2 {
    padding-left: 12px;
    border-left: 4px solid var(--accent);
    margin-top: 0;
}

.settings-media {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 24px;
    align-items: start;
}

.media-item {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
}

.media-item h3 {
    margin: 0;
    font-family: 'Exo 2', sans-serif;
}

.media-avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    border: 3px solid var(--accent);
    object-fit: cover;
}

.media-banner-img {
    width: 100%;
    min-width: 260px;
    height: 90px;
    border-radius: 10px;
    object-fit: cover;
    border: 1px solid var(--border);
}

.media-banner-default {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
}

/* ── Приватность: кликабельные тумблеры ──────────────────── */
.privacy-settings-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.privacy-setting-item {
    background: var(--card-alt);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 16px;
    transition: border-color var(--transition);
}

.privacy-setting-item:hover { border-color: var(--accent); }

.privacy-toggle-form {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
}

.privacy-label { font-weight: 500; }

.toggle-switch {
    position: relative;
    width: 52px;
    height: 28px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--card);
    cursor: pointer;
    flex-shrink: 0;
    padding: 0;
    transition: background var(--transition), border-color var(--transition);
}

.toggle-switch .toggle-knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--muted);
    transition: transform var(--transition), background var(--transition);
}

.toggle-switch.on {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    border-color: transparent;
}

.toggle-switch.on .toggle-knob {
    transform: translateX(24px);
    background: #fff;
}

@media (max-width: 700px) {
    .settings-media { grid-template-columns: 1fr; }
}
/* ══ НАСТРОЙКИ: кнопки и элементы на одном уровне ══════════ */

.media-item {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    align-content: flex-start;
}

/* Превью одинаковой высоты в обеих колонках */
.media-preview {
    flex-basis: 100%;
    height: 110px;
    display: flex;
    align-items: center;
}

/* Заголовок — отдельной строкой во всю ширину */
.media-item h3 {
    flex-basis: 100%;
    margin: 0;
}

/* Кнопки — в один ряд, без лишних отступов */
.media-item form {
    margin: 0;
}
/* ══════════════════════════════════════════════════════════
   СТРАНИЦА РЕДАКТИРОВАНИЯ ИГРОКА
   ══════════════════════════════════════════════════════════ */

/* Все секции — карточки */
.page-admin-player-edit section {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px 24px;
    box-shadow: 0 6px 18px var(--shadow);
    margin-bottom: 20px;
    backdrop-filter: blur(10px);
}

.page-admin-player-edit section h2 {
    margin-top: 0;
    padding-left: 12px;
    border-left: 4px solid var(--accent);
}

/* ── Карточка игрока: аватар-иконка + инфо ───────────────── */
.player-info h2 {
    display: flex;
    align-items: center;
    gap: 14px;
}

.player-info h2::before {
    content: "👤";
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    border-radius: 50%;
    font-size: 26px;
}

.player-info p { margin: 6px 0; }
.player-info strong { color: var(--muted); font-weight: 600; }

.player-info a[target="_blank"] {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--card-alt);
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    transition: all var(--transition);
}

.player-info a[target="_blank"]:hover {
    border-color: var(--accent);
    color: var(--accent);
}

/* ── Роли и предупреждения: строки с кнопкой справа ──────── */
.current-roles ul,
.warnings-section ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.current-roles li {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    background: var(--card-alt);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 10px 14px;
}

.warnings-section li {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    background: rgba(255, 193, 7, .08);
    border: 1px solid rgba(255, 193, 7, .35);
    border-radius: 10px;
    padding: 10px 14px;
}

.current-roles li form,
.warnings-section li form {
    margin-left: auto;
}

/* ── Формы: лейблы сверху, поля на всю ширину ────────────── */
.assign-role-form form,
.ban-section form,
.warnings-section form {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.assign-role-form label,
.ban-section label,
.warnings-section label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
}

.assign-role-form select,
.assign-role-form input,
.ban-section input,
.ban-section textarea,
.warnings-section textarea {
    width: 100%;
    box-sizing: border-box;
}

/* ── Инфо о бане — красный блок ──────────────────────────── */
.ban-info {
    background: rgba(220, 53, 69, .08);
    border: 1px solid rgba(220, 53, 69, .4);
    border-radius: 10px;
    padding: 14px 16px;
}

.ban-info p { margin: 6px 0; }

/* ══ БЕЙДЖ "ТОЛЬКО САЙТ" ════════════════════════════════════ */

.site-only-badge {
    display: inline-block;
    margin-left: 6px;
    padding: 2px 8px;
    background: rgba(138, 180, 248, .18);
    color: #8ab4f8;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .3px;
}

.login-source-hint {
    display: block;
    font-size: 11px;
    color: var(--muted);
    font-style: italic;
    margin-top: 2px;
}


/* ══ ВЫПАДАЮЩИЙ СПИСОК ПОЛЬЗОВАТЕЛЕЙ ════════════════════════ */

.user-picker { position: relative; }

.user-picker-box {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    padding: 6px 10px;
    background: var(--input-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: border-color var(--transition);
}

.user-picker-box:focus-within { border-color: var(--accent); }

.user-picker-input {
    flex: 1;
    min-width: 120px;
    border: none;
    background: transparent;
    color: var(--text);
    padding: 6px 4px;
    outline: none;
}

.user-picker-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--glow);
    border: 1px solid var(--accent);
    color: var(--accent);
    padding: 3px 8px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
}

.user-picker-chip button {
    border: none;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font-size: 14px;
    padding: 0;
}

.user-picker-list {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 400;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    margin: 4px 0 0;
    padding: 6px;
    list-style: none;
    max-height: 220px;
    overflow: auto;
    box-shadow: 0 12px 28px var(--shadow);
}

.user-picker-list.open { display: block; }

.user-picker-list li {
    padding: 8px 10px;
    border-radius: 8px;
    cursor: pointer;
}

.user-picker-list li:hover {
    background: var(--hover);
    color: var(--accent);
}


/* ══ ПРИНЯТИЕ ОБРАЩЕНИЯ И ИСПОЛНИТЕЛИ ═══════════════════════ */

.accept-block {
    margin: 14px 0;
}

.assignee-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--glow);
    border: 1px solid var(--accent);
    color: var(--accent);
    font-weight: 600;
    font-size: 13px;
}

.assignee-badge.me {
    background: rgba(40, 167, 69, .15);
    border-color: #28a745;
    color: #28a745;
}

.no-assignee {
    color: var(--muted);
    font-style: italic;
}

.assignee-inline {
    margin-left: 8px;
    font-size: 12px;
}


/* ══ ЛИЧНЫЕ СООБЩЕНИЯ ═══════════════════════════════════════ */

.nav-unread,
.unread-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    background: #e57373;
    color: #fff;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    margin-left: 4px;
}

.new-message-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

/* Список чатов */
.chats-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.chat-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    background: var(--card-alt);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    color: var(--text);
    transition: all var(--transition);
}

.chat-item:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
}

.chat-item.chat-unread {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--glow);
}

.chat-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.chat-name {
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
}

.chat-preview {
    color: var(--muted);
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.chat-time {
    color: var(--muted);
    font-size: 12px;
    white-space: nowrap;
}

/* Окно диалога */
.chat-window {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 16px;
    max-height: 480px;
    overflow-y: auto;
    box-shadow: 0 6px 18px var(--shadow);
    margin-bottom: 14px;
}

.chat-messages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.chat-msg {
    display: flex;
    flex-direction: column;
    max-width: 75%;
}

.msg-out { align-self: flex-end; align-items: flex-end; }
.msg-in { align-self: flex-start; align-items: flex-start; }

.msg-bubble {
    padding: 10px 14px;
    border-radius: 14px;
    background: var(--card-alt);
    border: 1px solid var(--border);
}

.msg-out .msg-bubble {
    background: var(--glow);
    border-color: var(--accent);
}

.msg-time {
    font-size: 11px;
    color: var(--muted);
    margin-top: 2px;
}

.chat-send-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.privacy-locked {
    padding: 14px 16px;
    background: rgba(255, 193, 7, .1);
    border: 1px solid rgba(255, 193, 7, .4);
    border-radius: 10px;
    color: var(--text);
}


/* ══ АВАТАРКИ В СООБЩЕНИЯХ ══════════════════════════════════ */

.chat-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid var(--border);
}

.chat-msg {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    gap: 8px;
    max-width: 78%;
}

.chat-msg.msg-out {
    flex-direction: row-reverse;
}

.msg-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid var(--border);
}

.msg-avatar-letter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #fff;
    font-family: 'Exo 2', sans-serif;
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
}

.msg-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
}

.msg-out .msg-body {
    align-items: flex-end;
}


/* ══ СТРАНИЦА ВХОДА (единая авторизация) ════════════════════ */

html[data-theme] body.page-login {
    background: var(--bg) url("../stalker-bg.jpg") center / cover no-repeat fixed !important;
}

.login-wrap {
    min-height: 72vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 16px;
}

.login-card {
    max-width: 480px;
    width: 100%;
    text-align: center;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 44px 36px;
    box-shadow: 0 16px 48px var(--shadow);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
}

.login-logo {
    font-size: 58px;
    margin-bottom: 10px;
    filter: drop-shadow(0 0 18px var(--glow));
}

.login-title {
    margin: 0;
    font-family: 'Exo 2', sans-serif;
    letter-spacing: 2px;
    text-transform: uppercase;
}

.login-sub {
    color: var(--muted);
    letter-spacing: 2px;
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 600;
    margin: 6px 0 20px;
}

.login-text {
    color: var(--text);
    margin-bottom: 26px;
    line-height: 1.6;
}

.btn-steam {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 30px;
    border-radius: 12px;
    background: linear-gradient(135deg, #1b2838, #2a475e);
    border: 1px solid #3f6c8f;
    color: #fff;
    font-family: 'Exo 2', sans-serif;
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(0, 0, 0, .35);
    transition: transform var(--transition), box-shadow var(--transition);
}

.btn-steam:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(47, 129, 247, .45);
}

.login-hint {
    color: var(--muted);
    font-size: 13px;
    margin-top: 20px;
    line-height: 1.5;
}
/* ══ Синяя линия под заголовком входа — длинная и по центру ══ */

.login-card h1::after {
    display: block !important;
    position: static !important;
    transform: none !important;
    left: auto !important;
    width: min(260px, 70%) !important;
    margin: 14px auto 0 !important;
}

/* ══ СТРАНИЦЫ "О САЙТЕ" И "СПРАВКА" ═════════════════════════ */

.info-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.info-list li {
    padding: 10px 14px;
    background: var(--card-alt);
    border: 1px solid var(--border);
    border-radius: 10px;
    line-height: 1.6;
}

.footer-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
    font-size: 13px;
}

.footer-links a {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--transition);
}

.footer-links a:hover {
    color: var(--accent);
}

.footer-links .dot {
    color: var(--muted);
}


/* ═══════════════════════════════════════════════════════════════════
   СИСТЕМА ЗНАЧКОВ
   ═══════════════════════════════════════════════════════════════════ */

.badges-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
    margin-top: 20px;
}

.badge-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    text-align: center;
    transition: transform var(--transition);
}

.badge-card:hover {
    transform: translateY(-4px);
}

.badge-image {
    width: 80px;
    height: 80px;
    object-fit: contain;
    margin-bottom: 12px;
}

.badge-card h2 {
    font-size: 16px;
    margin: 0 0 8px 0;
}

.badge-description {
    font-size: 13px;
    color: var(--muted);
    margin: 0 0 8px 0;
}

.badge-owners {
    font-size: 12px;
    color: var(--muted);
    margin: 0;
}

.badges-admin-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.badge-admin-card {
    display: flex;
    gap: 20px;
    background: var(--card-alt);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px;
}

.badge-admin-card .badge-image {
    width: 100px;
    height: 100px;
    flex-shrink: 0;
}

.badge-info {
    flex: 1;
}

.badge-info h3 {
    margin: 0 0 8px 0;
    font-size: 18px;
}

.badge-info p {
    margin: 0 0 8px 0;
    color: var(--muted);
}

.badge-actions {
    margin: 12px 0;
    display: flex;
    gap: 8px;
}

.award-form {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
}

.award-form h4 {
    margin: 0 0 8px 0;
    font-size: 14px;
}

.award-form form {
    display: flex;
    gap: 8px;
}

.award-form select {
    flex: 1;
}

.log-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
}

.log-table th,
.log-table td {
    padding: 10px;
    text-align: left;
    border-bottom: 1px solid var(--border);
}

.log-table th {
    background: var(--card-alt);
    font-weight: 600;
}

.log-action-create { color: #4caf50; font-weight: 600; }
.log-action-award { color: #2196f3; font-weight: 600; }
.log-action-revoke { color: #ff9800; font-weight: 600; }
.log-action-delete { color: #f44336; font-weight: 600; }

/* Витрина значков в профиле */
.profile-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 16px;
}

.profile-badges .badge-mini {
    width: 60px;
    height: 60px;
    object-fit: contain;
    border: 2px solid var(--border);
    border-radius: 8px;
    padding: 4px;
    background: var(--card-alt);
    cursor: help;
    transition: transform var(--transition);
}

.profile-badges .badge-mini:hover {
    transform: scale(1.1);
}
