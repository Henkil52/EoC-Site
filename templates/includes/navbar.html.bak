{% set user = current_user|default({}) %}
{% set is_authenticated = user and user.get("steam_id") %}
{% set current_endpoint = request.endpoint or "" %}

<header class="site-header">
    <nav class="main-nav" aria-label="Основная навигация">
    <a href="{{ url_for('news.index') }}" class="nav-logo" title="Перейти к новостям">
        <span class="nav-logo-icon">☢️</span>
        <span class="nav-logo-main">Echo of Chernobyl</span>
        <span class="nav-logo-sub">| RP Project</span>
    </a>


        {# ── Основное меню ─────────────────────────────────── #}
        <ul class="nav-list">
            <li>
                <a href="{{ url_for('news.index') }}"
                   {% if current_endpoint.startswith("news.") %}aria-current="page"{% endif %}>
                    Новости
                </a>
            </li>

            <li>
                <a href="{{ url_for('groups.index') }}"
                   {% if current_endpoint.startswith("groups.") %}aria-current="page"{% endif %}>
                    Группировки
                </a>
            </li>

            <li>
                <a href="{{ url_for('rules.index') }}"
                   {% if current_endpoint.startswith("rules.") %}aria-current="page"{% endif %}>
                    Правила
                </a>
            </li>

            <li>
                <a href="{{ url_for('lore.index') }}"
                   {% if current_endpoint.startswith("lore.") %}aria-current="page"{% endif %}>
                    Лор
                </a>
            </li>

                        <li>
                <a href="{{ url_for('leaderboard.index') }}"
                   {% if current_endpoint.startswith("leaderboard.") %}aria-current="page"{% endif %}>
                    🏆 Лидеры
                </a>
            </li>

            {# Ссылка на админку для администраторов и выше #}
            {% if is_authenticated and user.get("is_admin") %}
                <li>
                    <a href="{{ url_for('admin.dashboard') }}"
                       {% if current_endpoint.startswith("admin.") %}aria-current="page"{% endif %}
                       class="admin-link">
                        ⚙️ Админка
                    </a>
                </li>
            {% endif %}
        </ul>
            <li class="nav-theme">
                <div class="bell-wrap">
                    <button class="bell-btn" id="bellBtn" title="Уведомления" aria-label="Уведомления">
<svg class="bell-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
<span class="bell-dot" id="bellBadge" hidden></span>
</button>
                    <div class="bell-panel" id="bellPanel" hidden>
                        <div class="bell-head">
                            <span>Уведомления <span class="bell-count" id="bellCount"></span></span>
                            <button class="bell-readall" id="bellReadAll">Прочитать все</button>
                        </div>
                        <div class="bell-list" id="bellList"></div>
                    </div>
                </div>
                <button id="theme-toggle" class="theme-toggle"
                        onclick="cycleTheme()"
                        title="Сменить тему оформления">
                    <span id="theme-icon">🌙</span>
                </button>
            </li>

        {# ── Профиль пользователя ──────────────────────────── #}
        {% if is_authenticated %}
            {% set nickname = user.get("nickname") or "Гость" %}
            {% set avatar_url = user.get("avatar_url") or "" %}

            <div class="profile-dropdown" id="profileDropdown">
                <button type="button" class="profile-button" onclick="toggleProfileMenu(event)">
                    {% if avatar_url %}
                        <img src="{{ avatar_url }}" alt="Аватар">
                    {% else %}
                        <span class="avatar-placeholder">{{ nickname[:1] }}</span>
                    {% endif %}

                    <span class="profile-name">{{ nickname }}</span>
                </button>

                <ul class="profile-menu">
                    {# ── Бейджи ролей ─────────────────────────── #}
                    <li class="role-badges">
                        {# Роль сайта #}
                        {% if user.get("site_role_display") %}
                            <span class="role-badge site-role"
                                  {% if user.get("site_role_color") %}
                                  style="color: {{ user.get('site_role_color') }}"
                                  {% endif %}>
                                {{ user.get("site_role_icon", "") }}
                                {{ user.get("site_role_display") }}
                            </span>
                        {% endif %}

                        {# Роль в группировке #}
                        {% if user.get("faction_role") %}
                            <span class="role-badge faction-role">
                                {{ user.faction_role.icon }}
                                {{ user.faction_role.display_name }}
                                {% if user.faction_role.faction_name %}
                                    «{{ user.faction_role.faction_name }}»
                                {% endif %}
                            </span>
                        {% endif %}

                        {# Специальные роли #}
                        {% if user.get("special_roles") %}
                            {% for special in user.special_roles %}
                                <span class="role-badge special-role"
                                      {% if special.color %}
                                      style="color: {{ special.color }}"
                                      {% endif %}>
                                    {{ special.icon }}
                                    {{ special.display_name }}
                                </span>
                            {% endfor %}
                        {% endif %}

                        {# Предупреждения #}
                        {% if user.get("warnings_count", 0) > 0 %}
                            <span class="role-badge warning-badge">
                                ⚠️ Предупреждений: {{ user.warnings_count }}
                            </span>
                        {% endif %}
                    </li>

                    <li>
                        <a href="{{ url_for('messages.index') }}">
                            💬 Сообщения
                            {% set uc = unread_messages() %}
                            <span class="nav-unread" id="unread-count"
                                  {% if not uc %}style="display:none"{% endif %}>{{ uc }}</span>
                        </a>
                    </li>

                    <li class="menu-divider"></li>

                    {# ── Пункты меню ────────────────────────────── #}
                    <li>
                        <a href="{{ url_for('profile.my_profile') }}">
                            Мой профиль
                        </a>
                    </li>

                    <li>
                        <a href="{{ url_for('appeals.index') }}">
                            Мои обращения
                        </a>
                    </li>

                    <li>
                        <a href="{{ url_for('privacy.index') }}">
                            Настройки профиля
                        </a>
                    </li>

                    <li class="menu-divider"></li>

                    <li>
                        <a href="{{ url_for('auth.logout') }}" class="logout-link">
                            Выход
                        </a>
                    </li>
                </ul>
            </div>

        {% else %}
            {# ── Кнопка входа для неавторизованных ─────────── #}
            <a class="login-link" href="{{ url_for('auth.login', next=request.path) }}">
                Войти через Steam
            </a>
        {% endif %}

    </nav>
</header>